# SmartCart AI Agent - Production & Local Environment Example

# Google Gemini API Key (Required for Spring AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloud / Local MySQL Database Configuration
# Local default: jdbc:mysql://localhost:3306/smartcart_db
# Cloud (e.g. TiDB): jdbc:mysql://<cloud-host>:4000/<database>?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
SPRING_DATASOURCE_URL=jdbc:mysql://<cloud-host>:4000/test?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
SPRING_DATASOURCE_USERNAME=your_db_username_here
SPRING_DATASOURCE_PASSWORD=your_db_password_here
# Aliases also supported: DB_USERNAME, DB_PASSWORD, DB_URL, DATABASE_URL

# Server Port (Cloud platforms inject PORT automatically; default 8081)
PORT=8081

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
# Add your production frontend domain (e.g. https://smartcart-ai.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app
